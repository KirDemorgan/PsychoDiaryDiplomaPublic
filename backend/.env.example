# IDE Run Configuration: environment variables. Spring does not load .env automatically.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/diary
DB_USERNAME=diary
DB_PASSWORD=
# Required: base64 of at least 32 random bytes. Never commit the actual value.
JWT_SECRET_BASE64=
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Configure endpoint and exact model tag together. Empty values disable inference.
LLM_ENDPOINT=
LLM_MODEL_ID=
LLM_TOKEN=
LLM_TIMEOUT=PT30S
LLM_NUM_CONTEXT=16384
LLM_NUM_PREDICT=8192
# Speech service must implement the WAV -> {text,modelId} contract.
SPEECH_ENDPOINT=
SPEECH_MODEL_ID=
SPEECH_TOKEN=
