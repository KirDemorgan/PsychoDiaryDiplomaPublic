  stop
else (да)
endif
if (ASR настроен, нет активной задачи,
не превышены 30 загрузок/час?) then (нет)
  :503 / 409 / 429;
  stop
else (да)
endif
:Сохранить QUEUED + WAV, TTL 15 минут;
:Commit и 202 + Location;
|Worker|
:Захват: owner lock, TTL/согласие/попытки;
if (Задача ещё допустима?) then (нет)
  :EXPIRED / CANCELLED / FAILED;
  :Очистить аудио;
  stop
else (да)
endif
:RUNNING + leaseToken;
:Commit; максимум две попытки;
|ASR / будущая inference-обёртка|
:HTTP WAV → JSON text/modelId;
:Timeout 60 секунд;
|Worker|
:Проверить модель, JSON/размер,
непустой текст, длину и Unicode;
:Транзакция публикации: owner lock;
if (Статус, lease, TTL и согласие ещё актуальны?) then (нет)
  :Отбросить поздний результат;
  :При TTL/отзыве → очистить задачу;
  stop
else (да)
endif
if (Результат допустим?) then (нет)
  if (Переходная ошибка и это первая попытка?) then (да)
    :QUEUED, удалить lease;
    :Следующий захват повторяет ASR;
  else (нет)
    :FAILED, очистить WAV;
  endif
  stop
else (да)
endif
:SUCCEEDED; удалить WAV;
:Текст доступен 24 часа;
|iPhone / будущий клиент|
:GET собственной задачи;
:Показать редактируемую расшифровку;
if (Пользователь подтверждает текст?) then (нет)
