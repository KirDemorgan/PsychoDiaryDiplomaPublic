    {
      "id": "diary_design_009",
      "type": "text",
      "x": 1040,
      "y": 286,
      "width": 715.5625,
      "height": 187.5,
      "angle": 0,
      "strokeColor": "#233b3a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "card_6"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 100009,
      "version": 1,
      "versionNonce": 900009,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791392085740,
      "created": 1791392085740,
      "link": null,
      "locked": false,
      "fontSize": 25,
      "fontFamily": 2,
      "text": "Доступ: пользователь видит только свои данные.\nПриватность: секреты защищены, текст не пишется в логи.\nНадёжность: черновики, повторы без дублей, версии.\nОбъяснимость AI: цитаты, ссылки на факты, отказ при сбое.\niPhone: темы, крупный текст, VoiceOver, Reduce Transparency.\nВоспроизводимость: версии модели, тестов и сборки.",
      "originalText": "Доступ: пользователь видит только свои данные.\nПриватность: секреты защищены, текст не пишется в логи.\nНадёжность: черновики, повторы без дублей, версии.\nОбъяснимость AI: цитаты, ссылки на факты, отказ при сбое.\niPhone: темы, крупный текст, VoiceOver, Reduce Transparency.\nВоспроизводимость: версии модели, тестов и сборки.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
