    {
      "id": "diary_design_006",
      "type": "text",
      "x": 85,
      "y": 286,
      "width": 659.0,
      "height": 187.5,
      "angle": 0,
      "strokeColor": "#233b3a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "card_3"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 100006,
      "version": 1,
      "versionNonce": 900006,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791392085740,
      "created": 1791392085740,
      "link": null,
      "locked": false,
      "fontSize": 25,
      "fontFamily": 2,
      "text": "Дневник: оценки 0–10, записи, календарь и поиск.\nЛекарства: версии схем, приёмы и напоминания.\nNLP: теги с цитатами, отрицанием и временем.\nАналитика: динамика, даты и подтверждённый контекст.\nPDF: проверенный AI-обзор, предпросмотр и Share.\nГолос и данные: диктовка, вход, экспорт, удаление.",
      "originalText": "Дневник: оценки 0–10, записи, календарь и поиск.\nЛекарства: версии схем, приёмы и напоминания.\nNLP: теги с цитатами, отрицанием и временем.\nАналитика: динамика, даты и подтверждённый контекст.\nPDF: проверенный AI-обзор, предпросмотр и Share.\nГолос и данные: диктовка, вход, экспорт, удаление.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25
    },
